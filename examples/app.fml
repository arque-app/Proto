# app.fml — three unrelated journeys in one map.
# The smallest useful file: a roster, a couple of api nodes, and the wiring.

@meta
  title: App
  base: https://api.example.com

@nodes
  Login = page
  authApi = api
  Home = page
  Denied = page
  Cart = page
  payApi = api
  Receipt = page
  Settings = page
  Profile = page

@node authApi {
  method: POST
  path: /auth/login
  capture.token: $.data.token
  expect: 200
}

@node payApi {
  method: POST
  path: /payments
  header.Authorization: Bearer {token}
  expect: 200
}

@flow
  Login -submit> authApi
  authApi:
    -200> Home
    -401> Denied

  Cart -checkout> payApi
  payApi -200> Receipt

  Settings -edit> Profile
  Profile -save> Settings
