# checkout pulls in payment the same way — @fof nests.
@fof ./payment as payment

@meta
  title: Checkout

@nodes
  CartReview = page
  Address    = page
  Payment    = flow
  Confirm    = page

@node Payment {
  doc: payment
}

@flow
  CartReview -next> Address
  Address -next> Payment
  Payment -paid> Confirm
